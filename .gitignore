# --- BDB27 notebook run scratch (local) ---
bdb27_run/

# --- Data (lives on the USB; symlinked via data/raw) ---
data/*
!data/README.md
!data/.gitignore

# --- Generated outputs ---
outputs/*
!outputs/.gitkeep
!outputs/figures/
!outputs/figures/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Large artefacts ---
*.parquet
*.csv
*.zip

# --- Synthetic fixtures (SMALL, schema-compliant, committed) ---
!fixtures/**
!fixtures/**/*.csv
!fixtures/**/*.json
# ...but never generated stage output inside a fixture world
fixtures/**/outputs/
# ...nor bytecode: the `!fixtures/**` re-include above would otherwise catch it
fixtures/**/__pycache__/

# --- Archived legacy pipelines: code + notes are committed, local run artefacts are not ---
archive/**/outputs_local/
archive/**/*.parquet

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.~*

# --- Re-includes MUST come last: git takes the last matching pattern. ---
# Phase-gate evidence: small, machine-readable, and the artefact the audit note
# cites. Committed deliberately; the per-turn parquet stays ignored.
!outputs/audit/
!outputs/audit/*.csv
!outputs/audit/*.json
!outputs/figures/
!outputs/figures/*.png
!outputs/figures/.gitkeep
# Thresholds contract: its provenance field is the gate on stages 02-06.
!outputs/thresholds.json
# Stage timing / peak-RAM log. Small, and part of the handoff evidence.
!outputs/run_log.csv
# Figure artefacts: the PNG is not useful without the numbers behind it.
!outputs/figures/*.csv
!outputs/figures/*.json
# Speed-floor sensitivity (D190): small CSVs + manifest, committed evidence.
# It is a real-data sensitivity, not a FULL artefact and not a sample run.
!outputs/sensitivity/
!outputs/sensitivity/speed_floor/
!outputs/sensitivity/speed_floor/*.csv
!outputs/sensitivity/speed_floor/*.json
# Outcome-link feasibility (D196): small CSVs + summary, committed evidence.
# Feasibility counts only - SAMPLE provenance, no FULL outcome artefact.
!outputs/outcome_link/
!outputs/outcome_link/*.csv
!outputs/outcome_link/*.json
# Geometric attribution (D200): the SAMPLE run proves the code path end to end;
# the FULL run happens on Conor's laptop and is never committed from here. Small
# tables only - the per-file parquet shards stay ignored.
!outputs/geometric_attribution_sample/
!outputs/geometric_attribution_sample/*.csv
!outputs/geometric_attribution_sample/*.json
!outputs/geometric_attribution_sample/*.txt
# Fallback validation (D203): the diagnostic note's five artefacts. Small JSON,
# CSV and TXT; the per-turn parquet and every input stay ignored.
!outputs/fallback_validation/
!outputs/fallback_validation/*.json
!outputs/fallback_validation/*.csv
!outputs/fallback_validation/*.txt
# Turn context: the band/pass-run split and the field-availability table.
# Small CSVs + manifest are the evidence the note cites; the per-turn parquet is
# regenerated by scripts/turn_context.py and stays ignored.
!outputs/turn_context/
!outputs/turn_context/*.csv
!outputs/turn_context/*.json
# Received artefacts (D210): a file that arrived from Conor's laptop, committed
# byte-for-byte so the record is reproducible-by-diff. NOT a pipeline output --
# no code writes this directory, and PROVENANCE.md says so in its first line.
!outputs/ambiguity_attribution_received/
!outputs/ambiguity_attribution_received/*.csv
!outputs/ambiguity_attribution_received/*.md
# Received artefact (D211): the laptop paste behind figure 19's final step.
# Committed byte-for-byte, same convention as the block above: nothing writes
# this directory, and PROVENANCE.md says so in its first line. Stage 06 reads it
# read-only when it draws `fig_population_shrink`.
!outputs/population_shrink_received/
!outputs/population_shrink_received/*.csv
!outputs/population_shrink_received/*.md
