# --- BDB27 notebook run scratch (local) ---
bdb27_run/

# --- Data (lives on the USB; symlinked via data/raw) ---
data/*
!data/README.md
!data/.gitignore

# --- Generated outputs ---
outputs/*
!outputs/.gitkeep

# --- Writeup figures: the ≤5 deliverable figures are committed (small, deterministic PNGs; no data) ---
!outputs/figures/
!outputs/figures/*.png
!outputs/figures/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Large artefacts ---
*.parquet
*.csv
*.zip

# --- Synthetic fixtures (SMALL, schema-compliant, committed) ---
# TASK.md: commit only code/configs/notes/synthetic fixtures. Re-include the fixture dirs.
!fixtures/**
!fixtures/**/*.csv
!fixtures/**/*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.~*
