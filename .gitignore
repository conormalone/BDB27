# --- BDB27 notebook run scratch (local) ---
bdb27_run/

# --- Data (lives on the USB; symlinked via data/raw) ---
data/*
!data/README.md
!data/.gitignore

# --- Generated outputs ---
outputs/*
!outputs/.gitkeep
!outputs/figures/
!outputs/figures/.gitkeep

# --- Phase-gate evidence: small, machine-readable, and the artefact the audit
# note cites. Committed deliberately; the per-turn parquet stays ignored. ---
!outputs/audit/
!outputs/audit/*.csv
!outputs/audit/*.json

# Thresholds contract: small, and its provenance field is the gate on stages 02-06.
!outputs/thresholds.json

# Stage timing / peak-RAM log. Small, and part of the handoff evidence.
!outputs/run_log.csv

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Large artefacts ---
*.parquet
*.csv
*.zip

# --- Synthetic fixtures (SMALL, schema-compliant, committed) ---
!fixtures/**
!fixtures/**/*.csv
!fixtures/**/*.json
# ...but never generated stage output inside a fixture world
fixtures/**/outputs/
# ...nor bytecode: the `!fixtures/**` re-include above would otherwise catch it
fixtures/**/__pycache__/

# --- Archived legacy pipelines: code + notes are committed, local run artefacts are not ---
archive/**/outputs_local/
archive/**/*.parquet

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.~*
